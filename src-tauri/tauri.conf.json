{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sprigo",
  "version": "1.15.0",
  "identifier": "com.ozerozdas.sprigo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm fetch-model && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sprigo",
        "width": 1366,
        "height": 860,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Mehmet \u00d6zer \u00d6zda\u015f",
    "copyright": "\u00a9 2026 Mehmet \u00d6zer \u00d6zda\u015f",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "pipewire-gstreamer"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4OTE1MzE2NzdDQjBFQkUKUldTK0RzdDNGbE9SU0RRc253M3pVQitTSUlCaHhkY094bHo3cmNJNDlOa1Q5UmcrQXlQZmZOQm8K",
      "endpoints": [
        "https://github.com/nitrat1311/sprigo/releases/latest/download/latest.json"
      ]
    }
  }
}
